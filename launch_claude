#!/usr/bin/env python3
"""launch_claude - start named Claude Code sessions in tmux (optionally behind ttyd).

Single file, standard library only. See README.md for details.
"""
import sys

MIN_PYTHON = (3, 8)
if sys.version_info < MIN_PYTHON:
    sys.stderr.write("Python %d.%d or newer is required (found %s).\n"
                     % (MIN_PYTHON[0], MIN_PYTHON[1], sys.version.split()[0]))
    sys.exit(1)

import argparse  # noqa: E402
import configparser  # noqa: E402
import datetime  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import re  # noqa: E402
import shlex  # noqa: E402
import shutil  # noqa: E402
import socket  # noqa: E402
import stat  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402
import uuid  # noqa: E402
from pathlib import Path  # noqa: E402

__version__ = "0.1.1"

PROG = "launch_claude"
COMMANDS = ("start", "stop", "open", "add", "set", "forget", "list", "help")
RESERVED = ("all",) + COMMANDS
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
MODES = ("new", "resume", "continue")

DEFAULT_PORT_MIN = 7700
DEFAULT_PORT_MAX = 7799

# Timings (seconds). Module-level so tests can shorten them.
READY_TIMEOUT = 60       # how long to wait for the Claude Code prompt
STALL_TIMEOUT = 20       # give up early if the screen has not changed for this long
POLL_INTERVAL = 1.0
KEY_DELAY = 0.5          # pause between typing a slash command and pressing Enter
COMMAND_DELAY = 1.0      # pause between two slash commands
DIALOG_TIMEOUT = 10      # how long to watch for the Remote Control dialog
DIALOG_SETTLE = 2        # stop watching once the screen has been still for this long

READY_RE = re.compile(r"\? for shortcuts|shift\+tab to cycle")
# The dialog /remote-control opens; "Continue" is its preselected, harmless choice.
RC_DIALOG_RE = re.compile(r"Remote Control[\s\S]*\u276f\s*Continue")
TRUST_RE = re.compile(r"trust this folder|trust the files", re.IGNORECASE)
SHELLS = ("bash", "zsh", "sh", "fish", "dash", "ksh", "tcsh", "csh")

# tmux session options used to recognise the sessions this tool started.
OPT_KIND = "@launch_claude"            # "agent" or "once"
OPT_DIR = "@launch_claude_dir"
OPT_PORT = "@launch_claude_port"
OPT_STARTED = "@launch_claude_started"

USAGE = """\
