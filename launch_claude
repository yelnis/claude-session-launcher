# Commands
# --------------------------------------------------------------------------

class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Error("%s\nRun '%s help' for usage." % (message, PROG))


def make_parser(command):
    return Parser(prog="%s %s" % (PROG, command), add_help=False, allow_abbrev=False)


def add_ttyd_options(parser):
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--with-ttyd", dest="ttyd", action="store_const", const=True, default=None)
    group.add_argument("--without-ttyd", "--no-ttyd", dest="ttyd", action="store_const", const=False)
    parser.add_argument("--port", type=int)
    parser.add_argument("--dir", dest="directory")


def check_ttyd_args(args):
    if args.port is not None and args.ttyd is False:
        raise Error("--port cannot be used together with --without-ttyd")


def resolve_dir(path):
    directory = os.path.realpath(os.path.expanduser(path))
    if not os.path.isdir(directory):
        raise Error("directory %s not found" % directory)
    return directory


def apply_changes(settings, agent_id, agent, args):
    """Apply --dir/--port/--with(out)-ttyd/--mode/--autostart to an agent dict.

    Returns True if anything changed.
    """
    before = dict(agent)
    if args.directory is not None:
        agent["dir"] = resolve_dir(args.directory)
    if args.port is not None:
        validate_port(args.port, agent_id)
        agent["ttyd"], agent["port"] = True, args.port
    elif args.ttyd is True and not agent["ttyd"]:
        agent["ttyd"], agent["port"] = True, pick_free_port(settings, agent_id)
    elif args.ttyd is False:
        agent["ttyd"], agent["port"] = False, None
    if getattr(args, "mode", None) is not None:
        agent["mode"] = args.mode
    if args.autostart is not None:
        agent["autostart"] = args.autostart
    return agent != before


def cmd_start(argv):
    parser = make_parser("start")
    parser.add_argument("--autostart", action="store_true")
    parser.add_argument("ids", nargs="*")
    args = parser.parse_args(argv)
    if args.autostart and args.ids:
        raise Error("start: give either IDs or --autostart, not both")
    if not args.autostart and not args.ids:
        sys.stderr.write("Error: start needs a target: <id>... or --autostart\n\n" + USAGE)
        return 1
    settings = load_settings()
    if args.autostart:
        ids = [i for i in registered_ids() if load_agent(i)["autostart"]]
        if not ids:
            info("No agent has autostart=1. Mark one with: %s set <id> --autostart" % PROG)
            return 0
    else:
        ids = args.ids
        for agent_id in ids:
            if load_agent(agent_id) is None:
                raise Error("'%s' is not registered. Use: %s open %s  (or: %s add %s)"
                            % (agent_id, PROG, agent_id, PROG, agent_id))
    status = 0
    for agent_id in ids:
        try:
            if start_registered(settings, agent_id) in ("skipped", "failed"):
                status = 1
        except Error as e:
            # Keep going: one broken agent must not block the others at boot.
            sys.stderr.write("Error: %s\n" % e)
            status = 1
    return status


def cmd_open(argv):
    parser = make_parser("open")
    parser.add_argument("--resume", action="store_true")
    parser.add_argument("--continue", "-c", dest="cont", action="store_true")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--autostart", action="store_const", const=True, default=None)
    add_ttyd_options(parser)
    parser.add_argument("positional", nargs="*")
    args = parser.parse_args(argv)

    if len(args.positional) > 2:
        raise Error("open: too many arguments: %s" % " ".join(args.positional))
    agent_id = args.positional[0] if args.positional else None
    if len(args.positional) == 2:
        if args.directory is not None:
            raise Error("open: directory given twice (positional and --dir)")
        args.directory = args.positional[1]
    check_ttyd_args(args)
    if args.resume and args.cont:
        raise Error("open: --resume and --continue cannot be combined")
    if args.once:
        for flag, used in (("--resume", args.resume), ("--continue", args.cont),
                           ("--autostart", args.autostart)):
            if used:
                raise Error("open: --once cannot be combined with %s "
                            "(--once is always a new, unregistered conversation)" % flag)
    mode = "resume" if args.resume else "continue" if args.cont else "new"
    settings = load_settings()

    if args.once:
        return open_once(settings, agent_id, args)

    if agent_id is None:
        raise Error("open needs an <id> (or use --once for an automatic one)")
    require_valid_id(agent_id)
    agent = load_agent(agent_id)
    changed = any(v is not None for v in (args.directory, args.port, args.ttyd, args.autostart))

    if session_exists(agent_id):
        if agent is None:
            raise Error("a tmux session named '%s' already exists and is not registered here. "
                        "Choose another ID, or stop it yourself first." % agent_id)
        if changed:
            raise Error("[%s] is running; stop it before changing its settings: %s stop %s"
                        % (agent_id, PROG, agent_id))
        info("[%s] is already running: %s" % (agent_id, access_text(agent_id, running_port(agent_id))))
        return 0
    if agent is None and session_exists(ttyd_session(agent_id)):
        raise Error("a tmux session named '%s' already exists. Choose another ID."
                    % ttyd_session(agent_id))

    if mode == "continue":
        # Check before registering anything, so a refused open leaves no trace.
        if args.directory is not None or agent is None:
            target = resolve_dir(args.directory or os.getcwd())
        else:
            target = os.path.realpath(agent["dir"])
        check_dir_free(target, agent_id)

    if agent is None:
        agent = {"dir": resolve_dir(args.directory or os.getcwd()), "ttyd": False, "port": None,
                 "mode": "new", "autostart": bool(args.autostart)}
        if args.port is not None:
            validate_port(args.port, agent_id)
            agent["ttyd"], agent["port"] = True, args.port
        elif args.ttyd is not False:
            agent["ttyd"], agent["port"] = True, pick_free_port(settings, agent_id)
        save_agent(agent_id, agent)
        info("Registered [%s]: %s" % (agent_id, describe(agent)))
    elif apply_changes(settings, agent_id, agent, args):
        save_agent(agent_id, agent)
        info("Saved settings for [%s]: %s" % (agent_id, describe(agent)))

    result = start_registered(settings, agent_id, mode=mode)
    return 0 if result in ("started", "running") else 1


def open_once(settings, agent_id, args):
    sessions = managed_sessions()
    if agent_id is None:
        base = "once-" + time.strftime("%H%M%S")
        agent_id, n = base, 1
        while agent_id in sessions or session_exists(agent_id) or load_agent(agent_id) is not None:
            n += 1
            agent_id = "%s-%d" % (base, n)
    else:
        require_valid_id(agent_id)
        if load_agent(agent_id) is not None:
            raise Error("'%s' is a registered agent; --once needs an unused ID" % agent_id)
        if session_exists(agent_id) or session_exists(ttyd_session(agent_id)):
            raise Error("a tmux session named '%s' (or '%s') already exists. Choose another ID."
                        % (agent_id, ttyd_session(agent_id)))
    directory = resolve_dir(args.directory or os.getcwd())
    port = None
    if args.port is not None:
        validate_port(args.port, agent_id)
        port = args.port
    elif args.ttyd is True:
        port = pick_free_port(settings, agent_id)
    return 0 if launch_session(settings, agent_id, directory, port, "new", once=True) else 1


def parse_add_set(command, argv):
    parser = make_parser(command)
    parser.add_argument("id")
    add_ttyd_options(parser)
    parser.add_argument("--mode", choices=MODES)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--autostart", dest="autostart", action="store_const", const=True, default=None)
    group.add_argument("--no-autostart", dest="autostart", action="store_const", const=False)
    args = parser.parse_args(argv)
    check_ttyd_args(args)
    require_valid_id(args.id)
    return args


def cmd_add(argv):
    args = parse_add_set("add", argv)
    settings = load_settings()
    if load_agent(args.id) is not None:
        raise Error("'%s' is already registered. Use: %s set %s ..." % (args.id, PROG, args.id))
    agent = {"dir": resolve_dir(args.directory or os.getcwd()), "ttyd": False, "port": None,
             "mode": args.mode or "new", "autostart": bool(args.autostart)}
    if args.port is not None:
        validate_port(args.port, args.id)
        agent["ttyd"], agent["port"] = True, args.port
    elif args.ttyd is not False:
        agent["ttyd"], agent["port"] = True, pick_free_port(settings, args.id)
    save_agent(args.id, agent)
    info("Registered [%s]: %s" % (args.id, describe(agent)))
    return 0


def cmd_set(argv):
    args = parse_add_set("set", argv)
    settings = load_settings()
    agent = load_agent(args.id)
    if agent is None:
        raise Error("'%s' is not registered. Use: %s add %s ..." % (args.id, PROG, args.id))
    if not apply_changes(settings, args.id, agent, args):
        info("[%s] nothing to change: %s" % (args.id, describe(agent)))
        return 0
    save_agent(args.id, agent)
    info("Saved settings for [%s]: %s" % (args.id, describe(agent)))
    if session_exists(args.id):
        info("[%s] is running; the new settings apply from the next start." % args.id)
    return 0


def cmd_forget(argv):
    parser = make_parser("forget")
    parser.add_argument("id")
    args = parser.parse_args(argv)
    if load_agent(args.id) is None and not agent_path(args.id).exists():
        raise Error("'%s' is not registered" % args.id)
    if session_exists(args.id):
        raise Error("[%s] is running. Stop it first: %s stop %s" % (args.id, PROG, args.id))
    delete_agent(args.id)
    info("Forgot [%s]." % args.id)
    return 0


def cmd_stop(argv):
    parser = make_parser("stop")
    parser.add_argument("ids", nargs="*")
    args = parser.parse_args(argv)
    sessions = managed_sessions()
    if args.ids:
        targets = []
        for agent_id in args.ids:
            if agent_id in sessions or load_agent(agent_id) is not None:
                targets.append(agent_id)
            else:
                raise Error("'%s' is neither registered nor a running session of %s" % (agent_id, PROG))
    else:
        targets = sorted(set(sessions) | set(i for i in registered_ids() if session_exists(i)))
        if not targets:
            info("Nothing is running.")
            return 0
    # If we are inside one of the targets, stop it last so the others are not left behind.
    me = current_session()
    targets.sort(key=lambda name: name == me)
    for agent_id in targets:
        if agent_id in sessions or session_exists(agent_id) or session_exists(ttyd_session(agent_id)):
            stop_session(agent_id)
        else:
            info("[%s] is not running." % agent_id)
    return 0


def short_path(path):
    home = os.path.expanduser("~")
    if path == home:
        return "~"
    if path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def short_time(iso):
    try:
        return datetime.datetime.strptime(iso, "%Y-%m-%dT%H:%M:%S").strftime("%m/%d %H:%M")
    except (TypeError, ValueError):
        return "-"


def cmd_list(argv):
    parser = make_parser("list")
    parser.add_argument("--running", action="store_true")
    parser.add_argument("--autostart", action="store_true")
    args = parser.parse_args(argv)
    sessions = managed_sessions()
    ip = None
    rows, missing = [], False

    def access(port, once):
        nonlocal ip
        if port:
            ip = ip or host_ip()
            text = "http://%s:%d" % (ip, port)
        else:
            text = "tmux only"
        return text + (" (once)" if once else "")

    for agent_id in registered_ids():
        try:
            agent = load_agent(agent_id)
        except Error as e:
            warn(str(e))
            continue
        if agent is None:
            continue
        running = agent_id in sessions or session_exists(agent_id)
        if (args.running and not running) or (args.autostart and not agent["autostart"]):
            continue
        directory = short_path(agent["dir"]) if agent["dir"] else "(not set)"
        if not agent["dir"] or not os.path.isdir(agent["dir"]):
            directory += " (!)"
            missing = True
        if running:
            # Show what is actually running, which may differ from edited settings.
            port = sessions[agent_id]["port"] if agent_id in sessions else agent["port"]
            where = access(port, False)
        else:
            where = "-"
        rows.append((agent_id, "running" if running else "stopped", where, directory,
                     agent["mode"], "*" if agent["autostart"] else "-",
                     short_time(load_state(agent_id).get("last_started"))))

    registered = set(registered_ids())
    if not args.autostart:
        for name in sorted(sessions):
            session = sessions[name]
            if name in registered:
                continue
            rows.append((name, "running", access(session["port"], session["kind"] == "once"),
                         short_path(session["dir"]) if session["dir"] else "-", "-", "-",
                         short_time(session["started"])))

    if not rows:
        info("No agents." if not (args.running or args.autostart) else "No matching agents.")
        return 0
    header = ("ID", "STATUS", "ACCESS", "DIR", "MODE", "AUTO", "LAST")
    widths = [max(len(row[i]) for row in [header] + rows) for i in range(len(header))]
    for row in [header] + rows:
        info("  ".join(cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
    if missing:
        info("(!) directory not found")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        sys.stderr.write(USAGE)
        return 1
    first, rest = argv[0], argv[1:]
    if first in ("help", "-h", "--help"):
        sys.stdout.write(USAGE)
        return 0
    if first in ("--version", "-V"):
        print("%s %s" % (PROG, __version__))
        return 0
    commands = {"start": cmd_start, "open": cmd_open, "add": cmd_add, "set": cmd_set,
                "forget": cmd_forget, "stop": cmd_stop, "list": cmd_list}
    try:
        if any(arg in ("-h", "--help") for arg in rest):
            sys.stdout.write(USAGE)
            return 0
        if first in commands:  # commands win over IDs of the same name
            return commands[first](rest)
        if first.startswith("-") or not ID_RE.match(first):
            raise Error("unknown command or option '%s'\nRun '%s help' for usage." % (first, PROG))
        return cmd_start(argv)  # shortcut: launch_claude <id>
    except Error as e:
        sys.stderr.write("Error: %s\n" % e)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
